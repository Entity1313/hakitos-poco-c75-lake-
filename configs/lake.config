# HakiOS fragment: the POCO C75 4G / Redmi 14C (lake) -- what is true of this phone and of no
# other with an MT6768. The board is a Helio G81 Ultra with 6 GB of DRAM, a 720 x 1640 panel shown
# one pixel to a pixel at scale 2 (fbscale=2 fbfit=3) and flipped rather than copied over
# (fb_flip=1), and a FocalTech FT8057M on SPI0, chip select 0. The FT8057M keeps its firmware in
# its own flash, so mtkloader does not download a TCM image: it only pulses reset on GPIO92.
# mtkloader adds the root (rd=md0 emmc_root=1) and cpus=4 touchscreen=1 comes from CONFIG_BOOTARGS.
CONFIG_DEVICE="lake"
CONFIG_DEVICE_TITLE="POCO C75 4G / Redmi 14C"
CONFIG_SOC="mt6768"

# ---- memory and processors -------------------------------------------------
# MT6768's DRAM starts here; XNU is given the free window above it (mtkloader/board.h).
CONFIG_DRAM_BASE=0x40000000
CONFIG_XNU_CORES=4

# ---- the boot partition ----------------------------------------------------
# boot_a holds 64 MB here (the Infinix Hot 20's is 32); an image any larger is refused by
# fastboot, so tools/chainboot.py checks against this number (make bootimg passes it).
CONFIG_BOOT_PARTITION=67108864

# ---- display ---------------------------------------------------------------
CONFIG_PANEL_WIDTH=720
CONFIG_PANEL_HEIGHT=1640
CONFIG_FBSCALE=2
CONFIG_FBFIT=3
CONFIG_FB_QUEUE=1
CONFIG_FB_FLIP=y
CONFIG_FB_INUSE=y
CONFIG_SURF_ALIGN=y
CONFIG_SURF_LOCKWAIT=y

# ---- touch screen: FocalTech FT8057M, SPI0 / CS0 ---------------------------
# The backend is ft8057_tcm.c (FocalTech fts_ts report format over SPI). The vendor HAL names in
# that file are the common tree's hakios_spi0_xfer()/hakios_gpio_*(); the loader needs the reset
# pin only, because the controller runs the firmware from its own flash.
CONFIG_HAKIOS_TCM=y
CONFIG_TOUCH_FT8057=y
CONFIG_TOUCH_FT8057_SPI_BUS="spi0.0"
CONFIG_TOUCH_FT8057_SPI_BASE=0x1100a000
CONFIG_TOUCH_FT8057_SPI_HZ=9600000
CONFIG_TOUCH_FT8057_IRQ_GPIO=1
CONFIG_TOUCH_FT8057_RESET_GPIO=92
CONFIG_TOUCH_FT8057_RESET_MS=15

# ---- buttons, clocks, GPU, sensors -----------------------------------------
CONFIG_BUTTONS=2
CONFIG_MTK_CPUFREQ=3
CONFIG_MALI=y
CONFIG_MALI_MHZ=800
CONFIG_SCP_STEP=7

# ---- what mtkloader puts on XNU's command line ------------------------------
# rd=md0 emmc_root=1 is added by the loader (XNU_ROOT_ARG); this fragment carries the rest.
CONFIG_BOOTARGS="cpus=4 touchscreen=1"
